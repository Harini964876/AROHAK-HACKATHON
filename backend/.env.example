# =============================================================================
# Grand Horizon Hotel Booking System - Environment Configuration
# =============================================================================

# Application Environment: 'development', 'staging', or 'production'
# In 'production' or 'staging', SECRET_KEY must be strong (>= 32 characters)
# and cannot equal the dev fallback, otherwise application boot fails.
ENVIRONMENT=development

# Security - Generate a secure key: openssl rand -hex 32
SECRET_KEY=dev-super-secret-key-change-in-prod-1234567890abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite WAL mode by default)
DATABASE_URL=sqlite:///./hotel_booking.db

# Allowed CORS Origins (Comma-separated list or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True

# Business Policy
FREE_CANCELLATION_HOURS=24
